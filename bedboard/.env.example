# --- Database ---
# Local development: leave as-is and a file called bedboard.db is created for you.
# On Vercel: create a free Turso database (Vercel Marketplace -> Turso) and paste its URL + token.
DATABASE_URL=file:bedboard.db
DATABASE_AUTH_TOKEN=

# --- Login security ---
# Any long random string. Generate one with:  openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Password for the /admin page
ADMIN_PASSWORD=change-me

# --- Email (inquiries go to each home owner's email) ---
# Free account at https://resend.com. Without a key, inquiries are still saved
# and shown on the owner page, and the email is printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=BedBoard <onboarding@resend.dev>

# Used in email links, e.g. https://bedboard.vercel.app
SITE_URL=http://localhost:3000
